      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{2668A890-5E8E-450A-9F02-AB8A4011F26D}"
          SQLTask:SqlStatementSource="INSERT INTO gold.dim_date&#xA;(&#xA;    date_key,&#xA;    full_date,&#xA;    year,&#xA;    month,&#xA;    month_name,&#xA;    day&#xA;)&#xA;SELECT DISTINCT&#xA;    CONVERT(INT, CONVERT(CHAR(8), CAST(s.ingestion_timestamp AS DATE), 112)),&#xA;    CAST(s.ingestion_timestamp AS DATE),&#xA;    YEAR(s.ingestion_timestamp),&#xA;    MONTH(s.ingestion_timestamp),&#xA;    DATENAME(MONTH, s.ingestion_timestamp),&#xA;    DAY(s.ingestion_timestamp)&#xA;FROM silver.products s&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM gold.dim_date d&#xA;    WHERE d.full_date = CAST(s.ingestion_timestamp AS DATE)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
